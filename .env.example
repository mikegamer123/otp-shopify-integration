# Copy to .env and fill in. NEVER commit .env — it's in .gitignore.

# --- Mock switches ---------------------------------------------------------
# Both default to ON so the project runs with no credentials at all.
# Turn each one off as that half becomes real.
SHOPIFY_MOCK=1
OTP_MOCK=1

# --- Shopify ---------------------------------------------------------------
# This store is on the new Dev Dashboard, not the legacy "Develop apps" flow.
# The app "OTP Payment Bridge" is already created and installed on nordis-garden
# with scopes: write_draft_orders, read_draft_orders, write_orders, read_orders,
# read_products, read_themes.
#
# Dev Dashboard apps do NOT hand out a static shpat_ token like legacy custom
# apps did - they only give a Client ID and Secret, and the access token has to
# be fetched via OAuth. Paste those two here, then run:  npm run get-token
# That script does the OAuth exchange locally and writes SHOPIFY_ADMIN_TOKEN
# below for you. Get them from:
#   dev.shopify.com > OTP Payment Bridge > Settings > Credentials
#
# This store answers on TWO hostnames and they are not interchangeable. From
# GET /shop.json (shop id 83109249252):
#   myshopify_domain = i4g1zh-4e.myshopify.com   <- API + OAuth identity
#   domain           = nordis-garden.myshopify.com <- customer-facing storefront
# Use myshopify_domain here: it is what OAuth returns as `shop` and what webhooks
# carry. Use the storefront domain in ALLOWED_ORIGINS - that is the Origin the
# theme's fetch() actually sends.
SHOPIFY_STORE=i4g1zh-4e.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Filled in automatically by `npm run get-token`. Leave blank.
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_API_VERSION=2025-01

# --- OTP banka (iPay) ------------------------------------------------------
# From OTP's e-commerce developer portal after contract + test access.
# Leave OTP_GATEWAY_URL blank to use the local mock gateway.
OTP_MERCHANT_ID=
OTP_SECRET_KEY=
OTP_GATEWAY_URL=

# --- This service ----------------------------------------------------------
# Must be a public https:// URL before real payments work — OTP's webhook has to
# reach it. Use an ngrok/cloudflared tunnel for sandbox testing.
APP_BASE_URL=http://localhost:3000
PORT=3000
MOCK_OTP_PORT=4000

# Origins your storefront is served from, comma-separated. Required or the
# theme's fetch() to /api/checkout is blocked by the browser. Never use "*".
# No custom domain is connected yet - add it here when you buy one.
# Both hostnames are listed because the storefront answers on both; the primary
# (nordis-garden) is the one browsers will normally be on.
ALLOWED_ORIGINS=https://nordis-garden.myshopify.com,https://i4g1zh-4e.myshopify.com

# Currency sent to OTP. Confirm the expected format with them (RSD vs 941).
STORE_CURRENCY=RSD

# --- Delivery --------------------------------------------------------------
# A Shopify draft order NEVER applies a delivery rate on its own. Create one
# with a full Serbian address and shipping_line comes back null and the total is
# the goods total — no error, nothing in the logs. So this is explicit:
#
#   require  (default) every checkout resolves a rate from Settings > Shipping
#            and delivery. No address, or no rate for that address, fails the
#            checkout. Needs the theme to collect an address before payment.
#   off      never add a delivery charge. Correct ONLY if delivery is genuinely
#            free or is arranged and paid outside the shop. Warns at boot.
#
# The store's Serbia zone currently has: Стандардна 359, Ekspresna dostava 1490,
# and Besplatna dostava (free) on orders of 50 000 RSD and up. Cheapest wins
# unless the customer picks one by name.
DELIVERY_MODE=require

# How long to wait for a payment webhook before telling the customer the attempt
# failed. Should be >= OTP's payment-session lifetime (ask them). Set to 0 to see
# the "payment not completed" page immediately when testing the abandon path.
ORDER_TIMEOUT_MINUTES=15

# --- Fiscalization (Phase 5) -----------------------------------------------
# Leave blank until you wire up your licensed L-PFR provider.
FISCAL_PROVIDER_URL=
FISCAL_PROVIDER_TOKEN=
